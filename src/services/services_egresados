const egresadoService = require('../services/egresados');

// Obtener todos los egresados
exports.getAllEgresados = async (req, res) => {
  try {
    const egresados = await egresadoService.obtenerEgresadoPorId(); // Puedes necesitar ajustar esta línea para obtener todos los egresados
    res.json(egresados);
  } catch (error) {
    res.status(500).json({ message: 'Error al obtener egresados' });
  }
};

// Crear un nuevo egresado
exports.createEgresado = async (req, res) => {
  try {
    const result = await egresadoService.crearEgresado(req.body);
    if (result.success) {
      res.status(201).json(result.data);
    } else {
      res.status(500).json({ message: result.error });
    }
  } catch (error) {
    res.status(500).json({ message: 'Error al crear egresado' });
  }
};
