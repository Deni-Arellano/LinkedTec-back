const express = require('express');
const { createEstudiante, getAllEstudiantes, getEstudianteById } = require('../controllers/estudiantes_controller');

const router = express.Router();

router.post('/api/estudiantes', createEstudiante);
router.get('/api/estudiantes', getAllEstudiantes);
router.get('/api/estudiantes/:id', getEstudianteById);

module.exports = router;
