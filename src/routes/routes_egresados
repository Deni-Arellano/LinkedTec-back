// src/routes/routes_egresados.js
const express = require('express');
const router = express.Router();
const egresadosController = require('../controllers/egresados_controller');

// Obtener todos los egresados
router.get('/usuarios/egresados', egresadosController.getAllEgresados);

// Crear un nuevo egresado
router.post('/usuarios/egresados', egresadosController.createEgresado);

// Obtener un egresado por ID
router.get('/usuarios/egresados/:id_usuario', egresadosController.getEgresadoPorId);

module.exports = router;
