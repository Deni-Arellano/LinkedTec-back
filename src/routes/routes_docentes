const express = require('express');
const router = express.Router();
const DocenteController = require('../controllers/docentes_controller');

// Ruta para crear un nuevo docente
router.post('/api/docentes', DocenteController.createDocente);

// Ruta para obtener todos los docentes
router.get('/api/docentes', DocenteController.getAllDocentes);

// Ruta para obtener un docente por ID
router.get('/api/docentes/:id', DocenteController.getDocenteById);

module.exports = router;
